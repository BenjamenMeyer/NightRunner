# NightRunner Frontend — Local Development Environment
# Used when running `npm run dev` against the local Docker deployment.

# Backend API base URL (matches the `app` service in docker-compose.yaml)
VITE_API_BACKEND_URL=http://localhost:8000/v1

# Vite proxy target (used in vite.config.js for /api proxy rewrites)
VITE_BACKEND_URL=http://localhost:8000

# OIDC authority — points to the oidc-server-mock container
VITE_OIDC_AUTHORITY=http://localhost:4000

# OIDC client ID — must match ClientId in docker-compose CLIENTS_CONFIGURATION_INLINE
VITE_OIDC_CLIENT_ID=client-id
