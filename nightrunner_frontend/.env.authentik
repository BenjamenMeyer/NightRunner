# .env.authentik
#
# Vite environment file for local React development with Authentik OIDC provider.
#
# Usage:
#   yarn --cwd nightrunner_frontend dev --mode authentik
#   -OR-
#   cp .env.authentik nightrunner_frontend/.env.local
#

VITE_API_BACKEND_URL=http://localhost:8000/v1
VITE_BACKEND_URL=http://localhost:8000
VITE_OIDC_AUTHORITY=http://localhost:3000/application/o/nightrunner
VITE_OIDC_CLIENT_ID=client-id
