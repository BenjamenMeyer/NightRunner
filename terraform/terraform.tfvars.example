project_id    = "your-gcp-project-id"
region        = "us-central1"
environment   = "dev"
db_password   = "SuperSecretPassword123!"
db_name       = "nightrunner"
db_user       = "nightrunner_user"
backend_image = "us-central1-docker.pkg.dev/your-gcp-project-id/nightrunner/backend:latest"

# ------------------------------------------------------------------------------
# CDN Selection: 'none' (dev), 'cloudflare' (Free CDN & DDoS), or 'gcp' ($18/mo)
# ------------------------------------------------------------------------------
cdn_provider = "none" # Options: "none", "cloudflare", "gcp"

# Optional Cloudflare Configuration (when cdn_provider = "cloudflare")
cloudflare_api_token = "YOUR_CLOUDFLARE_API_TOKEN"
cloudflare_zone_id   = "YOUR_CLOUDFLARE_ZONE_ID"
domain_name          = "nightrunner.example.com"

# GCP Billing Budget & Safeguards
billing_account_id    = "012345-6789AB-CDEF01" # Format: XXXXXX-XXXXXX-XXXXXX
monthly_budget_amount = 20.00                  # Monthly spend limit in USD for alerts

# Optional: Social Authentication Credentials (Firebase / Identity Platform)
google_client_id     = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
google_client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
github_client_id     = "YOUR_GITHUB_CLIENT_ID"
github_client_secret = "YOUR_GITHUB_CLIENT_SECRET"

# Optional: GitHub Organization Configuration (for automated secret management)
github_org       = "YOUR_GITHUB_ORG"
github_repo_name = "NightRunner"
